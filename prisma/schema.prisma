generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
  DRAFT
}

model Campaign {
  id        String         @id @default(cuid())
  name      String
  status    CampaignStatus
  budget    Float
  spend     Float          @default(0)
  leads     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("campaigns")
}